{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToonForge",
  "version": "0.1.0",
  "identifier": "org.silencio.toonforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ToonForge — Cartoon Shorts Studio",
        "width": 1280,
        "height": 780,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data:; media-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com",
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/**", "../out/**", "../voice/**", "../audio/**", "../src/videos/**"]
      }
    }
  }
}
